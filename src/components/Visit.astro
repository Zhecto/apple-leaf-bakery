---
import { siteInfo } from '../data/menu';
---

<section id="visit" class="py-16">
  <div class="wrap">
    <div class="max-w-[620px] mb-10">
      <span class="label block mb-2.5">Find Us</span>
      <h2 class="text-[clamp(28px,3.6vw,38px)]">Pickup, Winnipeg.</h2>
      <p class="mt-3 text-ink-soft">
        Right now, everything moves through the drop list — no walk-in
        storefront yet.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="bg-paper rounded-xl p-7 border border-ink/10">
        <h3 class="text-[19px] text-ink mb-3 flex items-center gap-2">📍 Pickup location</h3>
        <dl>
          <dt class="font-mono text-[11px] uppercase tracking-wider text-leaf-deep mt-3.5">Address</dt>
          <dd class="mt-1 text-[15px] text-ink-soft">{siteInfo.pickupAddress}</dd>
          <dt class="font-mono text-[11px] uppercase tracking-wider text-leaf-deep mt-3.5">Schedule</dt>
          <dd class="mt-1 text-[15px] text-ink-soft">{siteInfo.pickupSchedule}</dd>
        </dl>
      </div>
      <div class="bg-paper rounded-xl p-7 border border-ink/10">
        <h3 class="text-[19px] text-ink mb-3 flex items-center gap-2">📝 How ordering works</h3>
        <dl>
          <dt class="font-mono text-[11px] uppercase tracking-wider text-leaf-deep mt-3.5">Right now</dt>
          <dd class="mt-1 text-[15px] text-ink-soft">
            Orders are paused between monthly drops. Join the list below to
            hear the moment the next one opens.
          </dd>
          <dt class="font-mono text-[11px] uppercase tracking-wider text-leaf-deep mt-3.5">Next up</dt>
          <dd class="mt-1 text-[15px] text-ink-soft">
            Ordering directly through this site is coming soon — for now,
            drops are handled through our order form.
          </dd>
        </dl>
      </div>
    </div>
  </div>
</section>
